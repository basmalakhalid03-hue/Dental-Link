{
  "name": "dental-link",
  "version": "1.0.0",
  "private": true,
  "description": "DentalLink - Dental Lab Management System",
  "scripts": {
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
