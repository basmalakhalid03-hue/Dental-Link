{
  "version": 2,
  "installCommand": "npm install --prefix server && npm exec --prefix server -- prisma generate && npm install --prefix client && npm install",
  "buildCommand": "npm run build --prefix client",
  "outputDirectory": "client/dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/uploads/(.*)", "destination": "/api" },
    { "source": "/((?!api|uploads|assets|.*\\..*).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "server/prisma/dev.db"
    }
  }
}
